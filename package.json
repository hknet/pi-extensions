{
  "name": "pi-extensions",
  "version": "0.3.3",
  "description": "Pi agent extensions: advisor, thinking command, timestamps, and per-project model preferences",
  "type": "module",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "extension"
  ],
  "license": "EUPL-1.2",
  "author": "hknet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hknet/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/hknet/pi-extensions/issues"
  },
  "homepage": "https://github.com/hknet/pi-extensions",
  "files": [
    "packages/pi-advisor",
    "packages/pi-thinking-command",
    "packages/pi-timestamp",
    "packages/pi-set-model",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1",
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-tui": ">=0.84.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./packages/pi-advisor/advisor.ts",
      "./packages/pi-thinking-command/thinking-shortcut.ts",
      "./packages/pi-timestamp/timestamp.ts",
      "./packages/pi-set-model/set-model.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "rm -rf .tmp-test && tsc -p tsconfig.test.json && node --test .tmp-test/tests/**/*.test.js",
    "release:stage": "npm stage publish --workspace @hk_net/pi-advisor --workspace @hk_net/pi-thinking-command --workspace @hk_net/pi-timestamp --workspace pi-set-model --access public"
  },
  "allowScripts": {
    "@google/genai@1.52.0": false,
    "protobufjs@7.6.5": false
  }
}
